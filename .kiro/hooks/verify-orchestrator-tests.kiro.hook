{
  "name": "Verify Orchestrator Quick Acceptance",
  "version": "1.1.0",
  "description": "Run the quick offline acceptance suite (about 35-70 seconds) when orchestrator Python, tests or dashboard static files change.",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "agent-orchestrator/orchestrator/**/*.py",
      "agent-orchestrator/orchestrator/dashboard/static/*",
      "agent-orchestrator/tests/**/*.py"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "python -X utf8 agent-orchestrator/scripts/verify_delivery.py --quick --redact-logs --output ci-evidence/kiro-quick"
  }
}
